# Sui Configuration
SUI_NETWORK=testnet
SUI_PRIVATE_KEY=your_sui_private_key_here
SUI_PACKAGE_ID=0x...

# Alternative network-specific package IDs
SUI_TESTNET_PACKAGE_ID=0x...
SUI_DEVNET_PACKAGE_ID=0x...
SUI_LOCAL_PACKAGE_ID=0x...

# Walrus Configuration
WALRUS_NETWORK=testnet
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_STORAGE_URL=https://walrus-testnet.walrus.space

# Enable mock mode for development/testing (without Walrus access)
WALRUS_MOCK_MODE=false
